{
  "name": "odonto-plan",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./build",
  },
  "routes": [
    {
      "pattern": "odonto-plan.regexpattern.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
}
